  "classification_rules": {
    "note": "Applied after the base rules of ingest.js classify, in this order. A rule changes the base class only when the base class is in its refines list (the new rule is more specific). Patterns are regular expressions over the title (title_patterns, case-insensitive; title_patterns_cs, case-sensitive, for acronyms) or each folder name of the path (path_patterns, case-insensitive); a rule matches when any pattern matches. A source already classified is reclassified only by a refinement, and every reclassification is logged (audit source_reclassified).",
    "rules": [
      {
        "class": "meta_analysis",
        "refines": [
          "review_article",
          "research_article",
          "unclassified"
        ],
        "title_patterns": [
          "\\bmeta-?analys[ie]s\\b",
          "\\bnetwork meta-?analys"
        ],
        "path_patterns": [
          "meta-?analys"
        ]
      },
      {
        "class": "systematic_review",
        "refines": [
          "review_article",
          "research_article",
          "unclassified"
        ],
        "title_patterns": [
          "\\bsystematic (?:literature )?review\\b",
          "\\bumbrella review\\b",
          "\\bcochrane\\b"
        ],
        "path_patterns": [
          "systematic reviews?"
        ]
      },
      {
        "class": "landmark_trial",
        "refines": [
          "research_article",
          "unclassified"
        ],
        "title_patterns": [
          "\\brandomi[sz]ed,? (?:double-blind,? |open-label,? |placebo-controlled,? |controlled |clinical )*trial\\b",
          "\\btrial investigators\\b"
        ],
        "path_patterns": [
          "landmark",
          "\\btrials?\\b"
        ],
        "title_patterns_cs": [
          "\\b[A-Z][A-Z0-9-]{2,}\\b[^A-Za-z]{0,3}[Tt]rials?\\b"
        ]
      },
      {
        "class": "government_guidance",
        "refines": [
          "clinical_practice_guideline",
          "protocol",
          "unclassified"
        ],
        "title_patterns": [
          "centers for disease control",
          "national institutes of health",
          "food and drug administration",
          "department of (?:health|veterans affairs|defense)",
          "world health organization",
          "agency for healthcare research",
          "public health service",
          "dietary guidelines for americans",
          "national heart, lung"
        ],
        "path_patterns": [
          "\\bgovernment\\b",
          "\\bpublic health\\b",
          "^cdc$",
          "^nih$"
        ],
        "title_patterns_cs": [
          "\\b(?:CDC|NIH|NHLBI|NIDDK|FDA|CMS|AHRQ|HHS|VA/DoD|VA-DoD|NICE|WHO)\\b"
        ]
      }
    ]
  }
