  "change_log": [
    {
      "version": "1.0.0",
      "date": "2026-10-17",
      "summary": "Initial source classes mapped onto the spec's SOURCE TYPES and AUTHORITY HIERARCHY."
    },
    {
      "version": "1.1.0",
      "date": "2026-10-24",
      "summary": "Lifecycle stage 1: government guidance, systematic review and meta-analysis classes; landmark trials recognised. classification_rules refine the base classification only where they are more specific (refines)."
    }
  ],
  "note": "Every Source is classified into one class. authority_tier names an entry of ontology.authority_hierarchy; base_authority is the authority_score before freshness/supersession adjustment. copyright governs storage: 'licensed_no_verbatim' content (MKSAP, textbooks, question banks) is indexed and abstracted only — no verbatim text, no question stems — and never leaves the private store (D1 + the owner's Drive), never the repository. 'publisher_copyright_paraphrase' sources are paraphrased and cited, never reproduced (owner rule 7 of the registry precedence rules).",
  "extraction_depths": {
    "recommendations": "Guideline metadata, every recommendation (paraphrased) with class/strength, level of evidence, population, intervention, section, page; concepts covered; supersession links.",
    "claims": "Key claims (paraphrased) with provenance; concepts covered.",
    "evidence": "Evidence object (design, population, intervention, outcome, result direction); concepts covered.",
    "blueprint": "Blueprint topics, weights and task ratings (see blueprint registries).",
    "index_and_facets": "Section/chapter index (locators), concepts covered, abstracted facet facts and board pearls in the app's own words.",
    "index_only": "Section/chapter index (locators) and concepts covered.",
    "none": "Registered for completeness; not mined."
  },
