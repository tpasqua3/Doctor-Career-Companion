{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkos/schemas/learner_concept_state.schema.json",
  "title": "Learner concept state",
  "description": "KNOWLEDGE STATE CONFIDENCE: Mastery Score, Confidence Score, Interaction Count, Evidence Density, Signal Stability, Recency Score \u2014 per learner per object at any granularity level.",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "level": {
      "enum": [
        "specialty",
        "domain",
        "competency",
        "concept",
        "facet",
        "subfacet",
        "question",
        "blueprint_topic",
        "curriculum_node"
      ]
    },
    "mastery": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "interactions": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_density": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "stability": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "recency": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "retention": {
      "type": "object",
      "properties": {
        "estimate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "forgetting_risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "next_review": {
          "type": "string"
        }
      }
    },
    "calibration": {
      "type": "object",
      "properties": {
        "correct_confident": {
          "type": "integer",
          "minimum": 0
        },
        "correct_uncertain": {
          "type": "integer",
          "minimum": 0
        },
        "incorrect_confident": {
          "type": "integer",
          "minimum": 0
        },
        "incorrect_uncertain": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "knowledge_state": {
      "type": "string"
    },
    "board_relevance": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "updated": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "object_id",
    "level",
    "mastery",
    "confidence"
  ]
}
