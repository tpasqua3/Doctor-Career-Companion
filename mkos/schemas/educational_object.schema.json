{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkos/schemas/educational_object.schema.json",
  "title": "Educational object",
  "description": "EDUCATIONAL OBJECTS: Objectives, Assessments, Blueprints, Competencies, Lessons, Cases, Questions, Flashcards, Simulations, Curricula, Learning Paths.",
  "allOf": [
    {
      "$ref": "mkos_object.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "edu_kind": {
      "enum": [
        "objective",
        "assessment",
        "lesson",
        "case",
        "question",
        "flashcard",
        "simulation",
        "curriculum",
        "learning_path",
        "teaching_point",
        "clinical_pearl",
        "high_yield",
        "common_error",
        "lesson_target",
        "review_target",
        "clinical_pathway"
      ]
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-ref": "Concept"
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-ref": "Competency"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "knowledge_state_target": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objective_type": {
      "enum": [
        "learning",
        "assessment",
        "board",
        "remediation",
        "review",
        "canonical"
      ]
    },
    "subcompetencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-ref": "Recommendation"
    },
    "blueprint_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-ref": "BlueprintTopic"
    },
    "targets": {
      "type": "array",
      "items": {
        "enum": [
          "question",
          "flashcard",
          "case",
          "review",
          "lesson"
        ]
      },
      "description": "Educational targets this knowledge is suited to."
    },
    "source_id": {
      "type": "string"
    },
    "strength": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "anchor_concept": {
      "type": "string",
      "x-ref": "Concept",
      "description": "Canonical objectives (objective_type canonical): the concept the objective is anchored on (lifecycle.json objectives)."
    }
  },
  "required": [
    "edu_kind"
  ]
}
